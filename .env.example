# Set these in Vercel > Project > Settings > Environment Variables (Production). Never commit real values.

# Who may sign in (comma separated, lowercase). Everyone else is refused.
ADMIN_ALLOWED_EMAILS=you@example.com

# Shared with the team site (team.schools.zaqsa.com). 32+ random characters, identical on both.
SSO_SHARED_SECRET=

# Where the team site receives the sign-in token. Must match exactly.
TEAM_CALLBACK_URL=https://team.schools.zaqsa.com/api/platform/sso/callback

# 32+ random characters. Encrypts authenticator secrets stored in the database. Do not change it
# later (people would have to re-enrol their authenticator).
ADMIN_DATA_KEY=

# Firebase > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON file contents (or its base64).
FIREBASE_SERVICE_ACCOUNT=
