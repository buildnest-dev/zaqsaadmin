rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// Browsers can only READ the website content (the public site does that). Every write, and
// everything else (admin accounts, sessions, history), goes through the admin server, which uses
// a service account and is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{key} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
